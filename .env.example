# Copy this file to `.env` and change any value you want to test.
# Every line is optional: the defaults live in app/settings.py.

# Where Redis is running.
REDIS_URL=redis://localhost:6379/0
# Optional namespace; verification creates its own unique prefix.
REDIS_KEY_PREFIX=
REDIS_MAX_CONNECTIONS=100
REDIS_POOL_TIMEOUT_SECONDS=10
REDIS_SOCKET_TIMEOUT_SECONDS=5

# Which algorithm protects the API: sliding_window_log or token_bucket.
RATE_LIMIT_ALGORITHM=sliding_window_log

# Quota used for users that have no custom limit.
DEFAULT_LIMIT=5
DEFAULT_WINDOW_SECONDS=60

# The key that grants admin rights (needed for POST /api/config).
ADMIN_API_KEY=admin-secret-key

# Simultaneous active requests allowed per user (bonus 2).
MAX_ACTIVE_REQUESTS_PER_USER=200
ACTIVE_REQUESTS_TTL_SECONDS=30

# Pretend /api/data takes this long, so you can see requests overlap.
SIMULATED_WORK_SECONDS=0

# Name of this server copy (shown in the X-Served-By header).
INSTANCE_ID=api-local

# Redis used only by the automated tests (never your real data).
TEST_REDIS_URL=redis://localhost:6379/15
